/*
 * RNAFlowX Docker execution profile
 *
 * Executes pipeline processes inside the RNAFlowX container.
 */

docker {
    enabled = true
}

process {

    container = 'rnaflowx:1.0.0'

    /*
     * Conservative laptop execution.
     */
    maxForks = 1

    cpus = 2
    memory = 3.GB
    time = 2.h

    withName: 'FASTQC_RAW' {
        cpus = 1
        memory = 1.GB
    }

    withName: 'FASTQC_TRIMMED' {
        cpus = 1
        memory = 1.GB
    }

    withName: 'FASTP' {
        cpus = 2
        memory = 2.GB
    }

    withName: 'SALMON_QUANT' {
        cpus = 1
        memory = 3.GB
        time = 4.h
    }

    withName: 'DESEQ2' {
        cpus = 1
        memory = 3.GB
        time = 2.h
    }
}
