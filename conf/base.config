/*
 * RNAFlowX
 * Base process configuration
 *
 * Conservative settings for local laptop execution.
 */

process {

    /*
     * Only one process runs at a time.
     * This prevents multiple samples from competing for RAM.
     */
    maxForks = 1

    /*
     * Safe default resources.
     */
    cpus = 2
    memory = 3.GB
    time = 2.h

    /*
     * FastQC
     */
    withName: 'FASTQC_RAW' {
        cpus = 1
        memory = 1.GB
    }

    withName: 'FASTQC_TRIMMED' {
        cpus = 1
        memory = 1.GB
    }

    /*
     * fastp
     */
    withName: 'FASTP' {
        cpus = 2
        memory = 2.GB
    }

    /*
     * Salmon
     */
    withName: 'SALMON_QUANT' {
        cpus = 1
        memory = 3.GB
        time = 4.h
    }

    /*
     * DESeq2
     */
    withName: 'DESEQ2' {
        cpus = 1
        memory = 3.GB
        time = 2.h
    }
}
