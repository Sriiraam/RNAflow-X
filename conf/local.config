/*
 * RNAFlowX
 * Local execution profile
 *
 * Runs the workflow directly on the local machine.
 * Resource limits are inherited from conf/base.config.
 */

process {
    executor = 'local'
}

/*
 * Keep local execution conservative.
 * Only one task is submitted at a time.
 */
executor {
    queueSize = 1
}
