params {

    /*
     * Input data
     */
    samplesheet = 'assets/samplesheet.csv'

    /*
     * Reference
     */
    salmon_index = 'data/reference/salmon_index'
    tx2gene = 'data/reference/tx2gene.tsv'

    /*
     * Sample metadata
     */
    metadata = 'data/metadata.csv'

    /*
     * Output
     */
    outdir = 'results'

    /*
     * Pipeline metadata
     */
    project_name = 'RNAFlowX'
    version = '1.1.0'

    /*
     * Reproducible runtime
     */
    container_image = 'rnaflowx:1.1.0'

    /*
     * Optional workflow controls
     *
     * Used by miniature CI testing.
     * Production default keeps enrichment enabled.
     */
    skip_enrichment = false


    /*
     * QC thresholds
     *
     * PASS >= pass threshold
     * WARN >= warn threshold
     * FAIL < warn threshold
     */
    qc_q30_pass = 90.0
    qc_q30_warn = 80.0

    qc_retention_pass = 90.0
    qc_retention_warn = 75.0

    qc_mapping_pass = 80.0
    qc_mapping_warn = 70.0

}