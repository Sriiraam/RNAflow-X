/*
 * RNAFlowX
 * SLURM / HPC execution profile
 *
 * Portable baseline configuration.
 * Queue/account/cluster-specific options should be supplied by the
 * target HPC environment.
 */

process {

    executor = 'slurm'
    maxForks = 20

    /*
     * Allow multiple jobs to be submitted to the scheduler.
     * Actual concurrency remains controlled by the HPC scheduler.
     */
    queueSize = 20

    /*
     * Default resources
     */
    cpus = 2
    memory = 4.GB
    time = 4.h

    /*
     * Quality control
     */
    withName: 'FASTQC_RAW' {
        cpus = 1
        memory = 2.GB
        time = 1.h
    }

    withName: 'FASTQC_TRIMMED' {
        cpus = 1
        memory = 2.GB
        time = 1.h
    }

    /*
     * Preprocessing
     */
    withName: 'FASTP' {
        cpus = 2
        memory = 3.GB
        time = 2.h
    }

    /*
     * Transcript quantification
     */
    withName: 'SALMON_QUANT' {
        cpus = 4
        memory = 8.GB
        time = 6.h
    }

    /*
     * Gene-level aggregation
     */
    withName: 'TXIMPORT' {
        cpus = 1
        memory = 4.GB
        time = 2.h
    }

    /*
     * Differential expression
     */
    withName: 'DESEQ2' {
        cpus = 2
        memory = 8.GB
        time = 4.h
    }

    /*
     * Reporting
     */
    withName: 'MULTIQC' {
        cpus = 1
        memory = 2.GB
        time = 1.h
    }
}
